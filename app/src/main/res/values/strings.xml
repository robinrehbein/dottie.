    <string name="help_line1">THE DOT CIRCLES ON ITS OWN.</string>
    <string name="help_line2">TAP WHILE IT IS IN THE GREEN ZONE — TAP OUTSIDE OR OVERSHOOT = GAME OVER.</string>
