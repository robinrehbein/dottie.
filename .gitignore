.DS_Store
/build
# Auch die Build-Ordner der Module — ohne diese Zeile ist nur der
# Wurzelordner geschuetzt, und Kompilat wandert unbemerkt in den Index
# (genau so ist sync/build/ hineingeraten).
build/
/captures
.externalNativeBuild
.cxx
local.properties
# Sitzungs- und Fehlerdateien des Kotlin-Compiler-Daemons
/.kotlin

# Claude-Code-Arbeitsdaten (Agent-Worktrees etc.) — die geteilte
# Projekt-Konfiguration bleibt aber im Repo, sonst kennt sie niemand ausser
# dem Rechner, auf dem sie entstanden ist.
/.claude/*
!/.claude/settings.json

# iOS: Das Xcode-Projekt wird aus ios/project.yml generiert (XcodeGen) und
# gehoert deshalb NICHT ins Repo — eine eingecheckte Kopie wuerde still
# gegen die Definition auseinanderlaufen.
/ios/*.xcodeproj
/ios/*.xcworkspace
/ios/build/
/ios/DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/

# Web: Playwright & Co. fuer die Screenshot-Tests (die PWA selbst hat
# bewusst kein Build-Tooling).
node_modules/
/web/node_modules/
/web/package-lock.json
