<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ohne dieses Feature würde der Play Store die APK auch auf
         Nicht-Uhren-Geräten anbieten. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
            android:allowBackup="true"
            android:label="@string/app_name">

        <!-- Eigenständige Wear-App: läuft ohne installierte Companion-
             Phone-App und ohne dass das Telefon in Reichweite ist. Ohne
             dieses Flag verweigert der Play Store die separate
             Installation auf der Uhr. -->
        <meta-data
                android:name="com.google.android.wearable.standalone"
                android:value="true" />

        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
