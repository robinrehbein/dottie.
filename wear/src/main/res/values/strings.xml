<?xml version="1.0" encoding="utf-8"?>
<!-- Default = Englisch, wie im Phone-Modul. Deutsch liegt in values-de/. -->
<resources>
    <string name="app_name" translatable="false">Dottie.</string>
    <string name="tap">TAP</string>
    <!-- Tap daneben im Start: Der Lauf beginnt erst mit einem Tap im Grün. -->
    <string name="not_yet">NOT YET</string>
    <string name="best">BEST: %1$d</string>
    <string name="sound_on">SOUND: ON</string>
    <string name="sound_off">SOUND: OFF</string>
    <string name="new_record">NEW RECORD!</string>
    <string name="banner_record">RECORD BROKEN!</string>

    <!-- Daily Challenge: Modus-Umschalter und Tages-Stände. Die Serie ist
         bewusst kürzer als am Phone ("STREAK: 3" statt "STREAK: 3 DAYS") —
         mehr passt neben den Tagesbest nicht auf das runde Display. -->
    <string name="classic">CLASSIC</string>
    <string name="daily">DAILY</string>
    <string name="today_score">TODAY: %1$d</string>
    <string name="streak">STREAK: %1$d</string>

    <!-- Skin-Wähler. Die Skin-Namen selbst sind keine Ressourcen: Sie
         stehen als Aufzählungs-Namen in WearDotSkin, die Uhr ist
         einsprachig (siehe dort). %1$d = verdient, %2$d = erreichbar —
         Saison- und Gönner-Skins zählen nicht mit. -->
    <string name="skins">SKINS %1$d/%2$d</string>
    <string name="back">BACK</string>

    <!-- Medaillen-Namen, identisch zum Phone-Modul -->
    <string name="medal_bronze">BRONZE</string>
    <string name="medal_silver">SILVER</string>
    <string name="medal_gold">GOLD</string>
    <string name="medal_platinum">PLATINUM</string>

    <!-- Spott-Texte: Wear-taugliche Teilmenge der Phone-Arrays (kurz genug
         fürs runde Display, max. ~18 Zeichen); Auswahl deterministisch
         über score+best wie am Phone. -->
    <string-array name="taunts_zero">
        <item>SERIOUSLY?</item>
        <item>THAT WAS FAST.</item>
    </string-array>
    <string-array name="taunts_close">
        <item>ONLY %1$d SHORT!</item>
        <item>SO CLOSE!</item>
    </string-array>
    <string-array name="taunts_low">
        <item>THAT WAS NOTHING.</item>
        <item>YOU CAN DO BETTER.</item>
    </string-array>
    <string-array name="taunts_default">
        <item>AGAIN!</item>
        <item>DON\'T GIVE UP!</item>
    </string-array>

    <!-- Rückmeldung im Lauf, Texte wie am Phone (composeResources). -->
    <string name="perfect_plus">PERFECT! +%1$d</string>
    <string name="blind_plus">BLIND! +%1$d</string>
    <string name="banner_chain">ONE MORE!</string>
