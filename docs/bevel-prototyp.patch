+package de.robinrehbein.punkt.ui.world
+
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.geometry.Size
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.drawscope.DrawScope
+import androidx.compose.ui.graphics.lerp
+import de.robinrehbein.punkt.game.SceneId
+import kotlin.math.floor
+import kotlin.math.hypot
+import kotlin.math.roundToInt
+import kotlin.math.sin
+
+// PROTOTYP (lokal, nicht für main): Bevel-Look und Welten-Material, nur
+// um echte Beispielbilder zu rendern. Die richtige Umsetzung legt die
+// Farbableitung nach :core (siehe docs/bevel-look.md).
+
+/** Aktive Kulisse für den Prototyp, gesetzt von drawTimingWorld. */
+internal var protoScene: SceneId = SceneId.WIESE
+
+internal fun lighten(c: Color, t: Float = 0.35f): Color = lerp(c, Color.White, t)
+internal fun darken(c: Color, t: Float = 0.30f): Color = lerp(c, OutlineColor, t)
+
+/**
+ * Fläche mit Bevel: Grundfarbe, dunkle Kante unten und rechts, darüber
+ * helle Kante oben und links. Zu kleine Flächen bleiben flach.
+ */
+internal fun DrawScope.bevelRect(
+    color: Color,
+    topLeft: Offset,
+    size: Size,
+    edge: Float,
+    light: Color = lighten(color),
+    dark: Color = darken(color),
+    alpha: Float = 1f
+) {
+    drawRect(color, topLeft, size, alpha = alpha)
+    val e = edge.roundToInt().coerceAtLeast(1).toFloat()
+    if (size.width < e * 3f || size.height < e * 3f) return
+    drawRect(dark, Offset(topLeft.x, topLeft.y + size.height - e), Size(size.width, e), alpha = alpha)
+    drawRect(dark, Offset(topLeft.x + size.width - e, topLeft.y), Size(e, size.height), alpha = alpha)
+    drawRect(light, topLeft, Size(size.width - e, e), alpha = alpha)
+    drawRect(light, topLeft, Size(e, size.height - e), alpha = alpha)
+}
+
+/** Pixel-Maske zeichnen: '.' frei, sonst Farbe aus [pal]; (x, y) = oben links. */
+internal fun DrawScope.pixelMap(x: Float, y: Float, u: Float, rows: List<String>, pal: Map<Char, Color>) {
+    rows.forEachIndexed { r, row ->
+        row.forEachIndexed { k, ch ->
+            val col = pal[ch] ?: return@forEachIndexed
+            drawRect(col, Offset(x + k * u, y + r * u), Size(u, u))
+        }
+    }
+}
+
+// ===== Bahn-Blöcke je Welt =====
+
+internal class TrackLook(val base: Color, val light: Color, val dark: Color, val pattern: Int, val accent: Color)
+
+internal fun trackLook(scene: SceneId): TrackLook = when (scene) {
+    SceneId.WIESE -> TrackLook(GroundSandShade, Color(0xFFF1EBB5), Color(0xFFB0A55E), 0, Color.Transparent)
+    SceneId.WUESTE -> TrackLook(Color(0xFFE3B26A), Color(0xFFF6D59A), Color(0xFFB07A3A), 1, Color(0xFFB07A3A))
+    SceneId.MEER -> TrackLook(Color(0xFFB9844F), Color(0xFFD9A873), Color(0xFF7E5530), 2, Color(0xFF8E6038))
+    SceneId.BERG -> TrackLook(Color(0xFF9AA0AA), Color(0xFFC4C9D1), Color(0xFF6B707C), 3, Color.White)
+    SceneId.STADT -> TrackLook(Color(0xFFB9BCC4), Color(0xFFDDE0E6), Color(0xFF7E828C), 4, Color(0xFF7E828C))
+    SceneId.WELTRAUM -> TrackLook(Color(0xFFC9D2E2), Color(0xFFF0F4FA), Color(0xFF8490A8), 5, Color(0xFF7FD4FF))
+}
+
+/** Ein Bahn-Block im Raster der Bahn: Kontur außen, innen Material mit Bevel und Muster. */
+internal fun DrawScope.drawTrackBlock(b: TrackBlock) {
+    drawRect(OutlineColor, Offset(b.left, b.top), Size(b.outer, b.outer))
+    val look = trackLook(protoScene)
+    val l = b.faceLeft
+    val t = b.faceTop
+    val s = b.inner
+    val e = b.unit
+    bevelRect(look.base, Offset(l, t), Size(s, s), e, look.light, look.dark)
+    val n = (s / e).roundToInt()
+    val m = ((n - 1) / 2) * e
+    when (look.pattern) {
+        1 -> drawRect(look.accent, Offset(l + e, t + m), Size(s - 2 * e, e))           // Fuge
+        2 -> { drawRect(look.accent, Offset(l + m, t + e), Size(e, e))                  // Maserung
+               drawRect(look.accent, Offset(l + m, t + s - 2 * e), Size(e, e)) }
+        3 -> { drawRect(look.accent, Offset(l, t), Size(s, e))                          // Schneekappe
+               drawRect(look.accent, Offset(l, t), Size(e, e * 2)) }
+        4 -> { drawRect(look.accent, Offset(l + e, t + e), Size(e, e))                  // Nieten
+               drawRect(look.accent, Offset(l + s - 2 * e, t + s - 2 * e), Size(e, e)) }
+        5 -> drawRect(look.accent, Offset(l + m, t + m), Size(e, e))                    // Lämpchen
+    }
+}
+
+// ===== Zonen-Motiv je Welt (Körper bleibt grün) =====
+
+/** Motiv auf einem Zonenblock; (left, top, inner) = Grasfläche. Liefert false = Wiese (Bestand). */
+internal fun DrawScope.drawZoneMotif(left: Float, top: Float, inner: Float, u: Float, core: Boolean): Boolean {
+    val cx = (left + inner / 2f - u / 2f).roundToInt().toFloat()
+    val cy = (top + inner / 2f - u / 2f).roundToInt().toFloat()
+    fun dot(dx: Int, dy: Int, c: Color) = drawRect(c, Offset(cx + dx * u, cy + dy * u), Size(u, u))
+    val white = Color.White
+    when (protoScene) {
+        SceneId.WIESE -> return false
+        SceneId.WUESTE -> if (core) {
+            listOf(0 to -1, -1 to 0, 1 to 0, 0 to 1).forEach { (x, y) -> dot(x, y, Color(0xFFFFE08A)) }
+            dot(0, 0, Color.White)
+        } else {
+            dot(-1, -1, white); dot(1, 0, white); dot(-1, 1, white)
+        }
+        SceneId.MEER -> if (core) {
+            listOf(0 to -1, -1 to 0, 1 to 0, 0 to 1).forEach { (x, y) -> dot(x, y, white) }
+            dot(0, 0, DotBody)
+        } else {
+            dot(0, -1, GrassEdge); dot(0, -2, GrassEdge); dot(-1, 1, Color(0xFF7FD8F0))
+        }
+        SceneId.BERG -> if (core) {
+            listOf(0 to -1, -1 to 0, 1 to 0, 0 to 1, -1 to -1, 1 to 1, 1 to -1, -1 to 1).forEach { (x, y) -> dot(x, y, white) }
+            dot(0, 0, DotBody)
+        } else {
+            dot(-1, 0, Color(0xFFA8ACB4)); dot(1, -1, GrassLight); dot(0, 1, GrassDeep)
+        }
+        SceneId.STADT -> if (core) {
+            for (x in -1..1) for (y in -1..1) dot(x, y, white)
+        } else {
+            dot(-1, -1, Color(0xFFC8FF9A)); dot(1, -1, Color(0xFFC8FF9A))
+            dot(-1, 1, Color(0xFFC8FF9A)); dot(1, 1, Color(0xFFC8FF9A))
+        }
+        SceneId.WELTRAUM -> if (core) {
+            for (i in -2..2) dot(i, -i, white)
+            dot(-1, -1, white)
+        } else {
+            for (i in -1..2) dot(i, -i + 1, Color(0xFFC8FF9A))
+        }
+    }
+    return true
+}
+
+// ===== Dot "Kugel" =====
+
+internal fun kugelCell(col: Int, row: Int, base: Color, shine: Color): Color {
+    val mid = (GRID - 1f) / 2f
+    val rr = GRID / 2f - 0.25f
+    val dx = col - mid
+    val dy = row - mid
+    val s = (dx + dy) / (rr * 1.41421356f)
+    if ((base.red + base.green + base.blue) / 3f < 80f / 255f) return base
+    var out = when {
+        s < -0.42f -> lerp(base, shine, 0.55f)
+        s < -0.12f -> lerp(base, shine, 0.22f)
+        else -> base
+    }
+    if (s > 0.55f) out = lerp(out, OutlineColor, 0.28f)
+    return out
+}
+
+// ===== Minen mit Bevel =====
+
+internal fun mineBevelColor(ch: Char, r: Int, k: Int, rows: List<String>, red: Boolean, ball: Color): Color {
+    fun set(rr: Int, kk: Int) = rr in rows.indices && kk in rows[rr].indices && rows[rr][kk] != '.'
+    val darkEdge = !set(r, k + 1) || !set(r + 1, k)
+    val lightEdge = !set(r, k - 1) || !set(r - 1, k)
+    return when {
+        darkEdge -> if (red) Color(0xFF9E1F1C) else Color(0xFF0A080C)
+        lightEdge -> if (red) Color(0xFFFF8A7E) else Color(0xFF4E4656)
+        else -> ball
+    }
+}
+
+// ===== Böden je Welt =====
+
+internal fun DrawScope.drawProtoGround(cell: Float, top: Float, sand: Color, sandShade: Color, turfDark: Color, turfLight: Color): Boolean {
+    val w = size.width
+    val h = size.height
+    val c = cell
+    fun snap(v: Float) = floor(v / c) * c
+    when (protoScene) {
+        SceneId.WIESE -> {
+            drawRect(sand, Offset(0f, top), Size(w, h - top))
+            drawRect(sandShade, Offset(0f, top + c * 8), Size(w, c * 2))
+            // Kiesel
+            var i = 0
+            while (i < 14) {
+                val x = snap(((i * 0.618f) % 1f) * w)
+                val y = snap(top + c * 11 + ((i * 0.37f) % 1f) * (h - top - c * 14))
+                drawRect(lighten(sand), Offset(x, y - c), Size(c, c))
+                drawRect(darken(sand, 0.2f), Offset(x, y), Size(c * 2, c))
+                i++
+            }
+            val toothW = c * 5f
+            var x = 0f
+            var k = 0
+            while (x < w) {
+                val base = if (k % 2 == 0) turfLight else turfDark
+                bevelRect(base, Offset(x, top), Size(toothW, c * 4), c * 0.5f,
+                    lighten(base), darken(base, 0.2f))
+                x += toothW; k++
+            }
+            drawRect(GrassEdge, Offset(0f, top + c * 4), Size(w, c))
+            drawRect(OutlineColor, Offset(0f, top - c), Size(w, c))
+        }
+        SceneId.WUESTE -> {
+            drawRect(sand, Offset(0f, top), Size(w, h - top))
+            val bands = listOf(Color(0xFFD9B377), Color(0xFFCFA466), Color(0xFFC4955A))
+            bands.forEachIndexed { i, col ->
+                val y = top + c * (8 + i * 8)
+                drawRect(col, Offset(0f, y), Size(w, c * 4))
+                drawRect(lighten(col, 0.3f), Offset(0f, y), Size(w, c))
+                var fx = (i * 7 % 11) * c
+                while (fx < w) {
+                    drawRect(Color(0xFFB88A52), Offset(fx, y + c), Size(c, c * 3))
+                    fx += c * 23
+                }
+            }
+            // Dünenkante
+            var x = 0f
+            while (x < w) {
+                val hh = snap(c * (2.2f + 2f * sin(x / (c * 9f))))
+                drawRect(OutlineColor, Offset(x, top - hh - c), Size(c, c))
+                drawRect(Color(0xFFFFF0C8), Offset(x, top - hh), Size(c, c))
+                drawRect(turfLight, Offset(x, top - hh + c), Size(c, hh + c * 3))
+                x += c
+            }
+            drawRect(sandShade, Offset(0f, top + c * 4), Size(w, c))
+            // Kiesel, halb im Sand
+            val peb = listOf("..OOO..", ".OLLBO.", "OLBBBDO")
+            val pal = mapOf('O' to OutlineColor, 'L' to Color(0xFFE3BE82), 'B' to Color(0xFFC79A55), 'D' to Color(0xFFA57C42))
+            listOf(0.16f to 6, 0.2f to 7, 0.53f to 6, 0.82f to 7).forEach { (fx, dy) ->
+                pixelMap(snap(fx * w), top + c * dy, c, peb, pal)
+            }
+        }
+        SceneId.MEER -> {
+            drawRect(sand, Offset(0f, top), Size(w, h - top))
+            drawRect(Color(0xFF2A78B6), Offset(0f, top + c * 12), Size(w, c * 9))
+            drawRect(sandShade, Offset(0f, top + c * 21), Size(w, h - top - c * 21))
+            drawRect(OutlineColor, Offset(0f, top - c), Size(w, c))
+            var x = 0f
+            while (x < w) {
+                drawRect(turfDark, Offset(x, top), Size(c * 12, c * 4))
+                drawRect(OutlineColor, Offset(x + c * 2, top - c * 3), Size(c * 6, c))
+                drawRect(OutlineColor, Offset(x + c, top - c * 2), Size(c, c))
+                drawRect(OutlineColor, Offset(x + c * 8, top - c * 2), Size(c, c))
+                drawRect(turfDark, Offset(x + c * 2, top - c * 2), Size(c * 6, c * 2))
+                drawRect(Color.White, Offset(x + c * 3, top - c * 2), Size(c * 4, c))
+                drawRect(turfLight, Offset(x + c * 2, top), Size(c * 2, c))
+                x += c * 12
+            }
+            drawRect(Color(0xFF2A78B6), Offset(0f, top + c * 4), Size(w, c))
+            // Luftblasen: Ringe mit Glanz, kleine Begleitblase
+            listOf(0.13f to 25, 0.33f to 13, 0.57f to 28, 0.78f to 16).forEach { (fx, dy) ->
+                val bx = snap(fx * w)
+                val by = top + c * dy
+                for (yy in -2..2) for (xx in -2..2) {
+                    val d = hypot(xx.toFloat(), yy.toFloat())
+                    if (d in 1.5f..2.4f) drawRect(turfLight, Offset(bx + xx * c, by + yy * c), Size(c, c))
+                }
+                drawRect(Color.White, Offset(bx - c, by - c), Size(c, c))
+                drawRect(turfLight, Offset(bx + c * 4, by - c * 6), Size(c * 2, c * 2))
+            }
+        }
+        SceneId.BERG -> {
+            val rock = Color(0xFF9AA0AA)
+            drawRect(Color(0xFF6B707C), Offset(0f, top), Size(w, h - top))
+            var y = top + c * 6
+            var row = 0
+            while (y < h) {
+                var x = -((row * 5) % 8) * c
+                var n = 0
+                while (x < w) {
+                    val bw = c * (9 + (n * 7 + row * 3) % 7)
+                    bevelRect(rock, Offset(x + c, y + c), Size(bw - c, c * 6), c, Color(0xFFC4C9D1), Color(0xFF7A808A))
+                    x += bw; n++
+                }
+                y += c * 8; row++
+            }
+            drawRect(OutlineColor, Offset(0f, top - c), Size(w, c))
+            drawRect(sand, Offset(0f, top), Size(w, c * 5))
+            drawRect(Color.White, Offset(0f, top), Size(w, c))
+            drawRect(sandShade, Offset(0f, top + c * 4), Size(w, c))
+            var x = c * 3
+            while (x < w) {
+                val ln = 2 + ((x / c).toInt() * 7) % 3
+                drawRect(sandShade, Offset(x, top + c * 5), Size(c * 2, c * ln))
+                drawRect(turfDark, Offset(x, top + c * (5 + ln)), Size(c, c))
+                x += c * 9
+            }
+        }
+        SceneId.STADT -> {
+            drawRect(sand, Offset(0f, top), Size(w, h - top))
+            drawRect(OutlineColor, Offset(0f, top - c), Size(w, c))
+            var x = 0f
+            while (x < w) {
+                bevelRect(turfLight, Offset(x, top), Size(c * 14, c * 5), c, Color(0xFFC4BECC), turfDark)
+                drawRect(OutlineColor, Offset(x + c * 14, top), Size(c, c * 5))
+                x += c * 15
+            }
+            drawRect(sandShade, Offset(0f, top + c * 5), Size(w, c))
+            x = c * 4
+            while (x < w) {
+                drawRect(Color(0xFFF2C94C), Offset(x, top + c * 16), Size(c * 10, c * 2))
+                drawRect(Color(0xFFFFE08A), Offset(x, top + c * 16), Size(c * 10, c))
+                x += c * 20
+            }
+            drawRect(sandShade, Offset(0f, top + c * 26), Size(w, c * 2))
+            val gx = snap(w * 0.66f)
+            drawRect(OutlineColor, Offset(gx, top + c * 7), Size(c * 10, c * 4))
+            var k = 1
+            while (k < 9) { drawRect(turfDark, Offset(gx + k * c, top + c * 8), Size(c, c * 2)); k += 2 }
+        }
+        SceneId.WELTRAUM -> return true
+    }
+    return true
+}
+
+// ===== Findling und Brecher (aus dem Mockup) =====
+
+internal val BOULDER = listOf(
+    "....OOOOOOO.....",
+    "..OOLLLLLLBOO...",
+    ".OLLLLBBBBBBDO..",
+    ".OLLBBBBBBBBBDO.",
+    "OLLBBBBBBKBBBDO.",
+    "OLBBBBBBBBKBBDDO",
+    "OLBBBBBBBBBBBDDO",
+    "OBBBBBBBBBBBDDDO",
+    "ODDBBBBBBBBDDDDO",
+    "OOOOOOOOOOOOOOOO",
+)
+internal val PEBBLE = listOf("..OOOO..", ".OLLBBO.", "OLLBBBDO", "OBBBBDDO", "OOOOOOOO")
+internal val BREAKER = listOf(
+    ".......OOOOO.......",
+    ".....OOFWWWWOO.....",
+    "....OFWWLLLLWWO....",
+    "...OLLLBBBBBLWWO...",
+    "..OLBBBBOOOOBBWO.W.",
+    ".OLBBBBO....OBWO..W",
+    ".OLBBBO......OO....",
+    "OLBBBBO............",
+    "OBBBBBDO...........",
+    "OBBBBBDDOOOOOOOOOOO",
+)
+
+/** Findling plus Kiesel; [groundY] ist die Requisiten-Basis (Bodenkante + 2 Zellen). */
+internal fun DrawScope.drawBoulder(cx: Float, groundY: Float, cell: Float, dark: Color, body: Color, light: Color) {
+    val pal = mapOf('O' to OutlineColor, 'L' to light, 'B' to body, 'D' to dark, 'K' to darken(dark, 0.35f))
+    val base = groundY - cell * 2f
+    val x = floor((cx - 8 * cell) / cell) * cell
+    pixelMap(x, base - BOULDER.size * cell, cell, BOULDER, pal)
+    pixelMap(x + 14 * cell, base - PEBBLE.size * cell, cell, PEBBLE, pal)
+}
+
+/** Brecher mit eingerollter Krone und Gischt, Fuß über der Wasserlinie. */
+internal fun DrawScope.drawBreaker(cx: Float, groundY: Float, cell: Float, dark: Color, body: Color, light: Color) {
+    val pal = mapOf('O' to OutlineColor, 'W' to Color.White, 'F' to Color(0xFFDFF4FF), 'L' to light, 'B' to body, 'D' to dark)
+    val base = groundY - cell * 2f
+    val x = floor((cx - 9 * cell) / cell) * cell
+    pixelMap(x, base - (BREAKER.size + 2) * cell, cell, BREAKER, pal)
+}
