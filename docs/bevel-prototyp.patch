+// TEMPORÄR, nicht committen: Vorher-Bilder aller Welten für die Mockups.
+class TmpWeltenShots {
+    @Test
+    fun welten() {
+        val dir = File(System.getenv("SHOTS_DIR") ?: return, "welten-vorher").apply { mkdirs() }
+        SceneId.entries.forEach { scene ->
+            val game = TimingGame(Random(20260925L)).apply { twistOverride = setOf(Twist.FAKE) }
+            var frames = 0
+            while (game.hits < 1) {
+                game.update(1f / 240f)
+                if (game.relativeToZone().let { it >= -game.perfectHalf() * 0.5f && it <= game.perfectHalf() * 0.5f }) game.tap()
+                check(++frames < 2_000_000)
+            }
+            check(game.phase == GamePhase.RUNNING)
+            // Weiterlaufen lassen, bis die Falle liegt und der Punkt
+            // etwa 80 Grad vor der Zone ist (ohne zu tippen).
+            while (!(game.hasFakeZone && game.relativeToZone() in -1.5f..-1.3f)) {
+                game.update(1f / 240f)
+                check(game.phase == GamePhase.RUNNING)
+                check(++frames < 2_000_000)
+            }
+            ImageComposeScene(width = 1080, height = 2400, density = Density(2.625f)) {
+                Box(modifier = Modifier.fillMaxSize()) {
+                    Canvas(modifier = Modifier.fillMaxSize()) {
+                        drawTimingWorld(game, FxState(), SkinId.KLASSIK, scene, hour = 12, month = 6)
+                    }
+                    ScoreHud(score = game.score)
+                }
+            }.use { s ->
+                val data = s.render(0L).encodeToData(EncodedImageFormat.PNG)!!
+                File(dir, "${scene.name.lowercase()}.png").writeBytes(data.bytes)
+            }
+        }
+    }
+}
