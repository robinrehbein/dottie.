    <string name="help_line1">THE DOT CIRCLES ON ITS OWN.</string>
    <string name="help_line2">TAP WHILE IT IS IN THE GREEN ZONE — TAP OUTSIDE OR OVERSHOOT = GAME OVER.</string>
    <string name="help_line3">BRIGHT ZONE CENTER = PERFECT: +2 POINTS.</string>
    <string name="help_line4">PERFECT STREAK? +3, +4, UP TO +5 PER HIT!</string>
    <string name="help_line5">MEDALS: BRONZE AT 10, SILVER AT 20, GOLD AT 30, PLATINUM AT 40.</string>
